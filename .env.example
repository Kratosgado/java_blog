# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/blog_db
DB_USER=blog_user
DB_PASS=blog_password

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=blog_nosql

# JWT Configuration
JWT_SECRET=your-secret-key-min-256-bits-change-in-production
JWT_EXPIRATION=86400000

# CORS Configuration
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,https://studio.apollographql.com

# OAuth2 Configuration (Lab 7)
# Get these from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (OAuth client ID)
# 4. Set authorized redirect URI: http://localhost:8080/api/v1/oauth2/callback/google

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server Configuration
PORT=8080
