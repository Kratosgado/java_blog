<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.CommentsManagementController"
  fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
  stylesheets="@../css/theme.css">

  <VBox spacing="30" style="-fx-background-color: transparent;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
      <VBox spacing="5">
        <Label text="Comments Management"
          style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        <Label text="Review and moderate user comments"
          styleClass="subtitle-text" style="-fx-font-size: 14px;" />
      </VBox>
      <Region HBox.hgrow="ALWAYS" />
      <ComboBox fx:id="statusFilterCombo" promptText="Filter by Status"
        prefWidth="180" styleClass="modern-combo-box" />
    </HBox>

    <!-- Stats Cards -->
    <GridPane hgap="20" vgap="20">
      <columnConstraints>
        <ColumnConstraints percentWidth="33.33" />
        <ColumnConstraints percentWidth="33.33" />
        <ColumnConstraints percentWidth="33.33" />
      </columnConstraints>

      <!-- Total Comments -->
      <VBox spacing="12" styleClass="card" GridPane.columnIndex="0"
        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, -primary-color 0%, -primary-color-dimmed 100%); 
               -fx-padding: 24; -fx-background-radius: 16;">
        <Label text="💬" style="-fx-font-size: 24px;" />
        <Label text="Total Comments"
          style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);" />
        <Label fx:id="totalCommentsLabel" text="0"
          style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
      </VBox>

      <!-- Pending Review -->
      <VBox spacing="12" styleClass="card" GridPane.columnIndex="1"
        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #9ca3af 0%, #6b7280 100%); 
               -fx-padding: 24; -fx-background-radius: 16;">
        <Label text="⏳" style="-fx-font-size: 24px;" />
        <Label text="Pending Review"
          style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);" />
        <Label fx:id="pendingCommentsLabel" text="0"
          style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
      </VBox>

      <!-- Approved -->
      <VBox spacing="12" styleClass="card" GridPane.columnIndex="2"
        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #6b7280 0%, #4b5563 100%); 
               -fx-padding: 24; -fx-background-radius: 16;">
        <Label text="✓" style="-fx-font-size: 24px;" />
        <Label text="Approved" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);" />
        <Label fx:id="approvedCommentsLabel" text="0"
          style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
      </VBox>
    </GridPane>

    <!-- Comments Table -->
    <VBox VBox.vgrow="ALWAYS" styleClass="card" style="-fx-padding: 24; -fx-background-radius: 16;">
      <TableView fx:id="commentsTable" VBox.vgrow="ALWAYS"
        style="-fx-background-color: transparent;">
        <columns>
          <TableColumn fx:id="commentColumn" text="Comment" prefWidth="300" />
          <TableColumn fx:id="authorColumn" text="Author" prefWidth="140" />
          <TableColumn fx:id="postColumn" text="Post" prefWidth="200" />
          <TableColumn fx:id="dateColumn" text="Date" prefWidth="140" />
          <TableColumn fx:id="statusColumn" text="Status" prefWidth="110" />
          <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="200" />
        </columns>
      </TableView>
    </VBox>
  </VBox>
</ScrollPane>
