<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.TagsManagementController"
  fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
  stylesheets="@../css/theme.css">

  <VBox spacing="30" style="-fx-background-color: transparent;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
      <VBox spacing="5">
        <Label text="Tags Management"
          style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        <Label text="Organize your content with tags"
          styleClass="subtitle-text" style="-fx-font-size: 14px;" />
      </VBox>
      <Region HBox.hgrow="ALWAYS" />
      <Button fx:id="createTagBtn" text="➕ Create Tag" onAction="#showCreateForm"
        styleClass="primary-button-large" />
    </HBox>

    <!-- Create/Edit Form -->
    <VBox fx:id="tagFormContainer" spacing="20" styleClass="card"
      style="-fx-padding: 30; -fx-background-radius: 16;" managed="false" visible="false">

      <Label fx:id="formTitleLabel" text="Create New Tag"
        style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

      <GridPane hgap="20" vgap="20">
        <columnConstraints>
          <ColumnConstraints percentWidth="70" />
          <ColumnConstraints percentWidth="30" />
        </columnConstraints>

        <!-- Tag Name -->
        <VBox spacing="10" GridPane.columnIndex="0">
          <Label text="Tag Name *" styleClass="field-label" />
          <TextField fx:id="tagNameField" promptText="Enter tag name"
            styleClass="modern-text-field" />
        </VBox>

        <!-- Color Picker -->
        <VBox spacing="10" GridPane.columnIndex="1">
          <Label text="Color" styleClass="field-label" />
          <ColorPicker fx:id="tagColorPicker" maxWidth="Infinity"
            style="-fx-background-color: white; -fx-border-color: #e5e7eb; 
                   -fx-border-width: 2px; -fx-border-radius: 8px;" />
        </VBox>
      </GridPane>

      <!-- Description -->
      <VBox spacing="10">
        <Label text="Description (Optional)" styleClass="field-label" />
        <TextArea fx:id="tagDescriptionArea" promptText="Enter tag description..."
          prefHeight="100" wrapText="true"
          style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; 
                 -fx-border-width: 2px; -fx-border-radius: 8px; 
                 -fx-background-radius: 8px; -fx-padding: 12; -fx-font-size: 14px;" />
      </VBox>

      <!-- Actions -->
      <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="cancelFormBtn" text="Cancel" styleClass="outline" />
        <Button fx:id="saveTagBtn" text="Save Tag" styleClass="success-button" />
      </HBox>
    </VBox>

    <!-- Tags Grid -->
    <VBox spacing="20" VBox.vgrow="ALWAYS" styleClass="card"
      style="-fx-padding: 30; -fx-background-radius: 16;">
      <Label text="All Tags"
        style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
      <ScrollPane fitToWidth="true" prefHeight="500"
        style="-fx-background: transparent; -fx-background-color: transparent;">
        <FlowPane fx:id="tagsFlowPane" hgap="15" vgap="15" />
      </ScrollPane>
    </VBox>
  </VBox>
</ScrollPane>
