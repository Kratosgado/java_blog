### Lab 7 Epic 2 - JWT-Based Authentication Tests
### JWT Login, Token Validation, and Security Testing

### Base URL
@host = http://localhost:8080/api/v1

###############################################################################
### Epic 2 User Story 2.1 — JWT Login Endpoint Tests
###############################################################################

### Test 1: Successful Login (Epic 2 requirement: return token on success)
# @name successfulLogin
POST {{host}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "password123"
}

> {%
  client.test("Successful login returns JWT token", function() {
    client.assert(response.status === 200, "Expected 200 OK");
    client.assert(response.body.token, "Response should contain JWT token");
    client.assert(response.body.token.startsWith("eyJ"), "Token should be valid JWT format");
    client.assert(response.body.email === "alice@example.com", "Response should contain user email");
    client.log("✓ JWT Token received: " + response.body.token.substring(0, 50) + "...");

    // Save token for subsequent tests
    client.global.set("jwtToken", response.body.token);
    client.global.set("bearerToken", "Bearer " + response.body.token);
  });
%}

###

### Test 2: Failed Login - Invalid Email (Epic 2 requirement: 401 Unauthorized)
POST {{host}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "nonexistent@example.com",
  "password": "password123"
}

> {%
  client.test("Invalid email returns 401 Unauthorized", function() {
    client.assert(response.status === 401, "Expected 401 Unauthorized");
    client.assert(!response.body.token, "Should not return token for invalid credentials");
    client.log("✓ Invalid credentials correctly rejected");
  });
%}

###

### Test 3: Failed Login - Invalid Password (Epic 2 requirement: 401 Unauthorized)
POST {{host}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "wrongpassword"
}

> {%
  client.test("Invalid password returns 401 Unauthorized", function() {
    client.assert(response.status === 401, "Expected 401 Unauthorized");
    client.assert(!response.body.token, "Should not return token for invalid credentials");
    client.assert(response.body.message, "Should return error message");
    client.log("✓ Wrong password correctly rejected");
  });
%}

###

### Test 4: Login with Missing Fields (Validation)
POST {{host}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "",
  "password": ""
}

> {%
  client.test("Empty credentials return validation error", function() {
    client.assert(response.status === 400 || response.status === 401,
        "Expected 400 Bad Request or 401 Unauthorized");
    client.log("✓ Empty credentials rejected");
  });
%}

###

###############################################################################
### Epic 2 User Story 2.2 — JWT Token Validation & Claims Tests
###############################################################################

### Test 5: Decode JWT Token and Verify Claims
### Manual: Copy token from Test 1 and decode at https://jwt.io
### Expected Claims:
### - sub (subject): alice@example.com
### - roles: ["READER"] or ["AUTHOR"] or ["ADMIN"]
### - userId: <user-id>
### - iat (issued-at): <timestamp>
### - exp (expiry): <timestamp> (24 hours from iat)
### - Algorithm: HS256 (HMAC SHA-256)

###

### Test 6: Use Valid JWT Token for Protected Endpoint
GET {{host}}/reader/profile HTTP/1.1
Authorization: {{bearerToken}}

> {%
  client.test("Valid JWT token grants access to protected endpoint", function() {
    client.assert(response.status === 200, "Expected 200 OK with valid token");
    client.assert(response.body.data, "Should return profile data");
    client.log("✓ JWT authentication successful");
    client.log("User: " + response.body.data.username);
  });
%}

###

### Test 7: Access Protected Endpoint Without Token (Epic 2: 401 Unauthorized)
GET {{host}}/reader/profile HTTP/1.1

> {%
  client.test("Missing token returns 401 Unauthorized", function() {
    client.assert(response.status === 401, "Expected 401 Unauthorized");
    client.log("✓ Request without token correctly rejected");
  });
%}

###

