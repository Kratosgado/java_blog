GET {{host}}/reader/profile HTTP/1.1
Authorization: Bearer invalid-token-format

> {%
  client.test("Invalid token format returns 401 Unauthorized", function() {
    client.assert(response.status === 401, "Expected 401 Unauthorized");
    client.log("✓ Invalid token format rejected");
