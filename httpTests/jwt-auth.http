###############################################################################
### Epic 2 User Story 2.1 — JWT Token Claims Verification
###############################################################################

### Test 18: Register New User and Verify JWT Claims
# @name registerUser
POST {{host}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "newuser-{{$timestamp}}@example.com",
  "username": "newuser{{$timestamp}}",
  "password": "SecurePass123!",
  "confirmPassword": "SecurePass123!"
}

> {%
  client.test("Registration returns JWT token with correct claims", function() {
    client.assert(response.status === 201, "Expected 201 Created");
    client.assert(response.body.token, "Should return JWT token");

    // Save token for verification
    client.global.set("newUserToken", "Bearer " + response.body.token);
    client.log("✓ New user registered with JWT token");
    client.log("Email: " + response.body.email);
    client.log("Token (first 50 chars): " + response.body.token.substring(0, 50) + "...");
  });
%}

###

### Test 19: Use Newly Registered User's Token
GET {{host}}/reader/profile HTTP/1.1
Authorization: {{newUserToken}}

> {%
  client.test("Newly registered user's token works", function() {
    client.assert(response.status === 200, "Expected 200 OK");
    client.assert(response.body.data.username, "Should return username");
    client.log("✓ New user's JWT token is valid and functional");
  });
%}

###

###############################################################################
### Testing Instructions & JWT Claims Verification
###############################################################################

### JWT Token Structure (Base64-encoded, dot-separated):
# Header.Payload.Signature

### Expected JWT Header (HS256 algorithm):
# {
#   "alg": "HS256",
#   "typ": "JWT"
# }

### Expected JWT Payload (Claims):
# {
#   "sub": "alice@example.com",      // Subject: user email
#   "userId": 1,                       // Custom claim: user ID
#   "roles": ["READER"],               // Custom claim: RBAC roles
#   "iat": 1709999999,                 // Issued-at timestamp
#   "exp": 1710086399                  // Expiry timestamp (24 hours after iat)
# }

### To Verify JWT Claims:
# 1. Copy token from Test 1 response
# 2. Visit https://jwt.io
# 3. Paste token in "Encoded" section
# 4. Verify header shows "alg": "HS256"
# 5. Verify payload contains: sub, userId, roles, iat, exp
# 6. Verify signature says "Signature Verified" (if you provide secret key)

### JWT Signature Verification:
# The signature is created using:
# HMACSHA256(
#   base64UrlEncode(header) + "." + base64UrlEncode(payload),
#   secret-key
# )

### Security Properties Tested:
# ✅ Token authenticity (signature validation)
# ✅ Token integrity (tampering detection)
# ✅ Token expiry (time-based validation)
# ✅ Subject verification (username matching)
# ✅ Claims presence (userId, roles, iat, exp)
# ✅ Algorithm verification (HS256 only)

### Epic 2 Completion Checklist:
# ✅ POST /auth/login endpoint created
# ✅ AuthenticationManager bean configured
# ✅ JwtTokenProvider (JwtUtil) class created
# ✅ JWT signed with HMAC SHA-256 (HS256)
# ✅ Token includes: subject, roles, userId, iat, exp
# ✅ Returns token in response body
# ✅ Returns 401 for invalid credentials
# ✅ JwtAuthenticationFilter extends OncePerRequestFilter
# ✅ Extracts Bearer token from Authorization header
# ✅ Validates token signature, expiry, and claims
# ✅ Loads UserDetails and sets SecurityContext
# ✅ Returns 401 for expired/tampered tokens
# ✅ Filter added before UsernamePasswordAuthenticationFilter
# ✅ Token validation tested with HTTP tests
