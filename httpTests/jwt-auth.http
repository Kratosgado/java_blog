###############################################################################
### Epic 2 User Story 2.2 — Token Expiry & Security Tests
###############################################################################

### Test 10: JWT Token Validation Endpoint
GET {{host}}/auth/validate HTTP/1.1
Authorization: {{bearerToken}}

> {%
  client.test("Token validation endpoint works", function() {
    client.assert(response.status === 200, "Expected 200 OK");
    client.assert(response.body.data.valid === true, "Token should be valid");
    client.assert(response.body.data.username, "Should return username");
    client.log("✓ Token is valid: " + response.body.data.username);
  });
%}

###

### Test 11: Token Validation with Invalid Token
GET {{host}}/auth/validate HTTP/1.1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.invalid.signature

> {%
  client.test("Invalid token fails validation", function() {
    client.assert(response.status === 200, "Validation endpoint returns 200");
    client.assert(response.body.data.valid === false, "Token should be invalid");
    client.log("✓ Invalid token correctly identified");
  });
%}

###

### Test 12: Expired Token Test
### Note: To test expired token, you need to:
### 1. Create a token with very short expiry (modify jwt.expiration in application.yml to 1000ms)
### 2. Wait for token to expire
### 3. Try to use it
### Expected: 401 Unauthorized with "token expired" message

# Login with short-expiry token (requires jwt.expiration=1000 in config)
# POST {{host}}/auth/login HTTP/1.1
# Content-Type: application/json
#
# {
#   "email": "alice@example.com",
#   "password": "password123"
# }
#
# > {%
#   client.global.set("shortLivedToken", "Bearer " + response.body.token);
#   client.log("Short-lived token created. Wait 2 seconds before next test.");
# %}

###

# Wait 2 seconds, then try to use expired token
# GET {{host}}/reader/profile HTTP/1.1
# Authorization: {{shortLivedToken}}
#
# > {%
#   client.test("Expired token returns 401 Unauthorized", function() {
#     client.assert(response.status === 401, "Expected 401 for expired token");
#     client.log("✓ Expired token correctly rejected");
#   });
# %}

###

### Test 13: Tampered Token Test (Modified Signature)
### Epic 2 Requirement: Return 401 for tampered tokens

# Take a valid token and modify the signature part
GET {{host}}/reader/profile HTTP/1.1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjEsInJvbGVzIjpbIlJFQURFUiJdLCJzdWIiOiJhbGljZUBleGFtcGxlLmNvbSIsImlhdCI6MTcwOTk5OTk5OSwiZXhwIjoxNzEwMDg2Mzk5fQ.tampered_signature_here

> {%
  client.test("Tampered token returns 401 Unauthorized", function() {
    client.assert(response.status === 401, "Expected 401 for tampered token");
    client.log("✓ Tampered token signature correctly rejected");
  });
%}

###

### Test 14: Token with Modified Claims (Modified Payload)
### Modify the payload to escalate privileges (e.g., change READER to ADMIN)
### Expected: Signature validation fails → 401 Unauthorized

# Modified payload with escalated role (signature won't match)
GET {{host}}/admin/users HTTP/1.1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjEsInJvbGVzIjpbIkFETUlOIl0sInN1YiI6ImFsaWNlQGV4YW1wbGUuY29tIiwiaWF0IjoxNzA5OTk5OTk5LCJleHAiOjE3MTAwODYzOTl9.invalid_signature

> {%
  client.test("Modified claims token returns 401 Unauthorized", function() {
    client.assert(response.status === 401, "Expected 401 for modified claims");
    client.log("✓ Token with modified claims rejected (signature mismatch)");
  });
%}

###

###############################################################################
### Epic 2 User Story 2.2 — JWT Filter Chain Integration Tests
###############################################################################

### Test 15: JWT Filter Processes Before Authorization
### Verify JWT filter runs before role-based access control

# Valid READER token should NOT access ADMIN endpoint
GET {{host}}/admin/users HTTP/1.1
Authorization: {{bearerToken}}

> {%
  client.test("JWT filter authenticates before RBAC check", function() {
    // Should get 403 Forbidden (authenticated but insufficient role)
    // NOT 401 Unauthorized (which would mean JWT filter didn't run)
    client.assert(response.status === 403 || response.status === 401,
        "Expected 403 Forbidden or 401 if no ADMIN role");

    if (response.status === 403) {
      client.log("✓ JWT filter authenticated user, RBAC denied access (403)");
    } else {
      client.log("⚠ JWT filter may not have authenticated user (got 401)");
    }
  });
%}

###

### Test 16: Public Endpoints Bypass JWT Filter
### Verify public endpoints don't require JWT token

GET {{host}}/posts HTTP/1.1

> {%
  client.test("Public endpoint accessible without token", function() {
    client.assert(response.status === 200, "Expected 200 OK for public endpoint");
    client.log("✓ Public endpoint accessible without authentication");
  });
%}

###

### Test 17: OPTIONS Request (CORS Preflight) Bypasses JWT Filter
OPTIONS {{host}}/reader/profile HTTP/1.1
Origin: http://localhost:3000
Access-Control-Request-Method: GET
Access-Control-Request-Headers: Authorization

> {%
  client.test("CORS preflight request bypasses JWT filter", function() {
    client.assert(response.status === 200 || response.status === 204,
        "Expected 200/204 for OPTIONS preflight");
    client.assert(response.headers.valuesOf("Access-Control-Allow-Origin").length > 0,
        "Should return CORS headers");
    client.log("✓ CORS preflight handled correctly");
  });
%}

