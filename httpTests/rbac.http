### Lab 7 Epic 4 - Role-Based Access Control (RBAC) Tests
### OAuth2 and RBAC Testing

### Base URL
@host = http://localhost:8080/api/v1

###############################################################################
### SETUP: Login to get tokens for different roles
###############################################################################

### Login as ADMIN (if you have admin user)
# @name loginAdmin
POST {{host}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "password123"
}

> {%
  if (response.body.token) {
    client.global.set("adminToken", "Bearer " + response.body.token);
    client.log("Admin token saved");
  }
%}

###

### Login as AUTHOR (if you have author user)
# @name loginAuthor
POST {{host}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "author@example.com",
  "password": "password123"
}

> {%
  if (response.body.token) {
    client.global.set("authorToken", "Bearer " + response.body.token);
    client.log("Author token saved");
  }
%}

###

### Login as READER (regular user - default role)
# @name loginReader
POST {{host}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "password123"
}

> {%
  if (response.body.token) {
    client.global.set("readerToken", "Bearer " + response.body.token);
    client.log("Reader token saved");
  }
%}

###############################################################################
### ADMIN ENDPOINTS (Requires ADMIN role)
###############################################################################

### Admin: Get all users (with ADMIN token - should succeed)
GET {{host}}/admin/users HTTP/1.1
Authorization: {{adminToken}}

> {%
  client.test("Admin can access /admin/users", function() {
    client.assert(response.status === 200, "Expected 200 OK for ADMIN");
    client.assert(response.body.requiredRole === "ADMIN", "Should require ADMIN role");
  });
%}

###

### Admin: Get all users (with AUTHOR token - should fail 403)
GET {{host}}/admin/users HTTP/1.1
Authorization: {{authorToken}}

> {%
  client.test("Author cannot access /admin/users", function() {
    client.assert(response.status === 403, "Expected 403 Forbidden for AUTHOR");
  });
%}

###

### Admin: Get all users (with READER token - should fail 403)
GET {{host}}/admin/users HTTP/1.1
Authorization: {{readerToken}}

> {%
  client.test("Reader cannot access /admin/users", function() {
    client.assert(response.status === 403, "Expected 403 Forbidden for READER");
  });
%}

###

### Admin: Get all users (no token - should fail 401)
GET {{host}}/admin/users HTTP/1.1

> {%
  client.test("Unauthenticated cannot access /admin/users", function() {
    client.assert(response.status === 401, "Expected 401 Unauthorized");
  });
%}

###

### Admin: Promote user (ADMIN only)
POST {{host}}/admin/users/42/promote HTTP/1.1
Authorization: {{adminToken}}

> {%
  client.test("Admin can promote users", function() {
    client.assert(response.status === 200, "Expected 200 OK for ADMIN");
  });
%}

###

### Admin: Delete user (ADMIN only)
DELETE {{host}}/admin/users/42 HTTP/1.1
Authorization: {{adminToken}}

> {%
  client.test("Admin can delete users", function() {
    client.assert(response.status === 200, "Expected 200 OK for ADMIN");
  });
%}

###

### Admin: System stats (ADMIN only)
GET {{host}}/admin/system/stats HTTP/1.1
Authorization: {{adminToken}}

> {%
  client.test("Admin can view system stats", function() {
    client.assert(response.status === 200, "Expected 200 OK for ADMIN");
  });
%}

###############################################################################
### AUTHOR ENDPOINTS (Requires AUTHOR or ADMIN role)
###############################################################################

### Author: Get author posts (with ADMIN token - should succeed)
GET {{host}}/author/posts HTTP/1.1
Authorization: {{adminToken}}

> {%
  client.test("Admin can access author endpoints", function() {
    client.assert(response.status === 200, "Expected 200 OK for ADMIN");
  });
%}

###

### Author: Get author posts (with AUTHOR token - should succeed)
GET {{host}}/author/posts HTTP/1.1
Authorization: {{authorToken}}

> {%
  client.test("Author can access /author/posts", function() {
    client.assert(response.status === 200, "Expected 200 OK for AUTHOR");
    client.assert(response.body.requiredRoles, "Should specify required roles");
  });
%}

###

### Author: Get author posts (with READER token - should fail 403)
GET {{host}}/author/posts HTTP/1.1
Authorization: {{readerToken}}

> {%
  client.test("Reader cannot access /author/posts", function() {
    client.assert(response.status === 403, "Expected 403 Forbidden for READER");
  });
%}

###

