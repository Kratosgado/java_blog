### 


### ROLE HIERARCHY VALIDATION


### 


### Verify ADMIN has all permissions

# ADMIN should be able to access ADMIN, AUTHOR, and READER endpoints

GET {{host}}/admin/users HTTP/1.1
Authorization: {{adminToken}}

> {%
  client.test("ADMIN can access ADMIN endpoints", function () {
    client.assert(response.status === 200, "Admin endpoints accessible");
  });
%}


### 

GET {{host}}/author/posts HTTP/1.1
Authorization: {{adminToken}}

> {%
  client.test("ADMIN can access AUTHOR endpoints", function () {
    client.assert(response.status === 200, "Author endpoints accessible");
  });
%}


### 

GET {{host}}/reader/bookmarks HTTP/1.1
Authorization: {{adminToken}}

> {%
  client.test("ADMIN can access READER endpoints", function () {
    client.assert(response.status === 200, "Reader endpoints accessible");
  });
%}


### 


### Verify AUTHOR has limited permissions

# AUTHOR should access AUTHOR and READER endpoints, but NOT ADMIN

GET {{host}}/admin/users HTTP/1.1
Authorization: {{authorToken}}

> {%
  client.test("AUTHOR cannot access ADMIN endpoints", function () {
    client.assert(response.status === 403, "Admin endpoints forbidden");
  });
%}


### 

GET {{host}}/author/posts HTTP/1.1
Authorization: {{authorToken}}

> {%
  client.test("AUTHOR can access AUTHOR endpoints", function () {
    client.assert(response.status === 200, "Author endpoints accessible");
  });
%}


### 

GET {{host}}/reader/bookmarks HTTP/1.1
Authorization: {{authorToken}}

> {%
  client.test("AUTHOR can access READER endpoints", function () {
    client.assert(response.status === 200, "Reader endpoints accessible");
  });
%}


### 


### Verify READER has minimal permissions

# READER should only access READER endpoints

GET {{host}}/admin/users HTTP/1.1
Authorization: {{readerToken}}

> {%
  client.test("READER cannot access ADMIN endpoints", function () {
    client.assert(response.status === 403, "Admin endpoints forbidden");
  });
%}


### 

GET {{host}}/author/posts HTTP/1.1
Authorization: {{authorAuth}}

> {%
  client.test("READER cannot access AUTHOR endpoints", function () {
    client.assert(response.status === 403, "Author endpoints forbidden");
  });
%}


### 

GET {{host}}/reader/bookmarks HTTP/1.1
Authorization: {{readerAuth}}

> {%
  client.test("READER can access READER endpoints", function () {
    client.assert(response.status === 200, "Reader endpoints accessible");
  });
%}
