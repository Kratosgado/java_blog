> {%
  client.test("Author can create drafts", function () {
    client.assert(response.status === 200, "Expected 200 OK for AUTHOR");
  });
%}


### 


### Author: Publish post (AUTHOR or ADMIN)

PUT {{host}}/author/posts/publish HTTP/1.1
Authorization: {{authorToken}}

> {%
  client.test("Author can publish posts", function () {
    client.assert(response.status === 200, "Expected 200 OK for AUTHOR");
  });
%}


### 


### Author: Get analytics (AUTHOR or ADMIN)

