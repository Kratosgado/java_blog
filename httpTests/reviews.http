### Reviews API Tests

### Base URL
@host = http://localhost:8080/api

### 
### IMPORTANT: Run auth.http login test first to set the adminAuth token
### 

### Create a New Review
# @name createReview
POST {{host}}/reviews HTTP/1.1
Content-Type: application/json
Authorization: {{adminAuth}}

{
  "postId": 1,
  "rating": 5,
  "title": "Excellent Article!",
  "content": "This is a very well-written and informative article. I learned a lot from it and would highly recommend it to others."
}

###

### Create Another Review (4 stars)
# @name createReview4Stars
POST {{host}}/reviews HTTP/1.1
Content-Type: application/json
Authorization: {{adminAuth}}

{
  "postId": 1,
  "rating": 4,
  "title": "Good Content",
  "content": "Pretty good article overall. Could use a bit more detail in some sections, but generally helpful."
}

###

### Get a Review by ID
# @name getReview
GET {{host}}/reviews/{{reviewId}} HTTP/1.1

###

### Update a Review
# @name updateReview
PUT {{host}}/reviews/{{reviewId}} HTTP/1.1
Content-Type: application/json
Authorization: {{adminAuth}}

{
  "rating": 5,
  "title": "Updated: Excellent Article!",
  "content": "After re-reading, I appreciate this even more. The examples are very clear and practical. Definitely a 5-star article!"
}

###

### Delete a Review
# @name deleteReview
DELETE {{host}}/reviews/{{reviewId}} HTTP/1.1
Authorization: {{adminAuth}}

###

### Get Reviews for a Post (with pagination)
# @name getPostReviews
GET {{host}}/reviews/post/1?page=0&size=10&sort=createdAt,desc HTTP/1.1

###

### Get Reviews for a Post - Page 2
# @name getPostReviewsPage2
GET {{host}}/reviews/post/1?page=1&size=5 HTTP/1.1

###

### Get Reviews by User
# @name getUserReviews
GET {{host}}/reviews/user/1?page=0&size=10 HTTP/1.1

###

### Get Review Statistics for a Post
# @name getPostReviewStats
GET {{host}}/reviews/post/1/stats HTTP/1.1

###

### Test Create Review with Invalid Rating (validation error)
# @name createInvalidReview
POST {{host}}/reviews HTTP/1.1
Content-Type: application/json
Authorization: {{adminAuth}}

{
  "postId": 1,
  "rating": 6,
  "title": "Invalid",
  "content": "Rating should be between 1-5"
}

###

### Test Create Review with Missing Required Fields
# @name createReviewMissingFields
POST {{host}}/reviews HTTP/1.1
Content-Type: application/json
Authorization: {{adminAuth}}

{
  "postId": 1,
  "rating": 5
}

###

### Test Create Review for Non-existent Post
# @name createReviewInvalidPost
POST {{host}}/reviews HTTP/1.1
Content-Type: application/json
Authorization: {{adminAuth}}

{
  "postId": 99999,
  "rating": 5,
  "title": "This should fail",
  "content": "Post does not exist"
}

###

### Test Create Duplicate Review (should fail if already reviewed)
# @name createDuplicateReview
POST {{host}}/reviews HTTP/1.1
Content-Type: application/json
Authorization: {{adminAuth}}

{
  "postId": 1,
  "rating": 5,
  "title": "Duplicate",
  "content": "User already reviewed this post"
}

###

### Test Create Review without Authentication (should return 401)
# @name createReviewUnauthorized
POST {{host}}/reviews HTTP/1.1
Content-Type: application/json

{
  "postId": 1,
  "rating": 5,
  "title": "Unauthorized",
  "content": "This should fail - no auth token"
}

###

### Test Update Review without Authentication (should return 401)
# @name updateReviewUnauthorized
PUT {{host}}/reviews/{{reviewId}} HTTP/1.1
Content-Type: application/json

{
  "rating": 4,
  "title": "Unauthorized Update",
  "content": "This should fail"
}

###

### Test Delete Review without Authentication (should return 401)
# @name deleteReviewUnauthorized
DELETE {{host}}/reviews/{{reviewId}} HTTP/1.1

###

### Test Update Another User's Review (should return 403 or error)
# @name updateOtherUserReview
PUT {{host}}/reviews/some_other_user_review_id HTTP/1.1
Content-Type: application/json
Authorization: {{adminAuth}}

{
  "rating": 1,
  "title": "Trying to modify someone else's review",
  "content": "This should fail"
}

###
