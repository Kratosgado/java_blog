### Lab 7 - Spring Security Tests


### Epic 1 & 3: CORS, CSRF, JWT Authentication, and Role-Based Access Control


### Base URL

@host = http://localhost:8080/api/v1


### 


### 1. AUTHENTICATION FLOW


### 


### Register a new user

# @name register

POST {{host}}/auth/register HTTP/1.1
Content-Type: application/json

{
  "bio": "Test user for security testing",
  "confirmPassword": "SecurePass123!",
  "email": "testuser@example.com",
  "password": "SecurePass123!",
  "username": "testuser"
}

> {%
  client.test("Status is 201", function () {
    client.assert(response.status === 201, "Expected 201 Created");
  });
  client.test("Response has JWT token", function () {
    client.assert(response.body.token, "Token should be present");
    client.global.set("testUserToken", "Bearer " + response.body.token);
  });
%}


### 


### Login with existing credentials

# @name login

POST {{host}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "kratos@gmail.com",
  "password": "28935617Aa@"
}

> {%
  client.test("Status is 200", function () {
    client.assert(response.status === 200, "Expected 200 OK");
  });
  client.test("Response has JWT token", function () {
    client.assert(response.body.token, "Token should be present");
    var parts = response.body.data.token.split(".");
    client.assert(parts.length === 3, "JWT should have 3 parts");
    client.global.set("readerAuth", "Bearer " + response.body.token);
  });
  client.test("Response includes user data", function () {
    client.assert(response.body.id, "User ID should be present");
    client.assert(response.body.username, "Username should be present");
    client.assert(response.body.email, "Email should be present");
    client.assert(response.body.role, "Role should be present");
  });
%}


### 


### Validate JWT token

# @name validateToken

GET {{host}}/auth/validate HTTP/1.1
Authorization: {{readerAuth}}

> {%
  client.test("Status is 200", function () {
    client.assert(response.status === 200, "Expected 200 OK");
  });
  client.test("Token is valid", function () {
    client.assert(response.body.data.valid === true, "Token should be valid");
    client.assert(response.body.data.username, "Username should be present");
  });
%}


### 


### Login with invalid credentials (should fail)

# @name loginFailed

POST {{host}}/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "wrongpassword"
}

> {%
  client.test("Status is 401", function () {
    client.assert(response.status === 401, "Expected 401 Unauthorized");
  });
%}


### 


### 2. CORS TESTS


### 


### CORS Preflight - Allowed Origin

# Test OPTIONS request with allowed origin

OPTIONS {{host}}/posts HTTP/1.1
Origin: http://localhost:3000
Access-Control-Request-Method: POST
Access-Control-Request-Headers: Authorization, Content-Type

> {%
  client.test("Status is 200", function () {
    client.assert(response.status === 200, "Expected 200 OK");
  });
  client.test("CORS headers present", function () {
    client.assert(
      response.headers.valueOf("Access-Control-Allow-Origin") ===
        "http://localhost:3000",
      "Should allow localhost:3000",
    );
    var methods = response.headers.valueOf("Access-Control-Allow-Methods");
    client.assert(methods.includes("GET"), "Should allow GET");
    client.assert(methods.includes("POST"), "Should allow POST");
    client.assert(methods.includes("DELETE"), "Should allow DELETE");
  });
  client.test("Headers include Authorization", function () {
    var headers = response.headers.valueOf("Access-Control-Allow-Headers");
    client.assert(
      headers.includes("Authorization"),
      "Should allow Authorization header",
    );
    client.assert(
      headers.includes("Content-Type"),
      "Should allow Content-Type header",
    );
  });
  client.test("Credentials enabled", function () {
    client.assert(
      response.headers.valueOf("Access-Control-Allow-Credentials") === "true",
      "Credentials should be enabled",
    );
  });
%}


### 


### CORS Request - Allowed Origin

# Test actual GET request with allowed origin

GET {{host}}/posts HTTP/1.1
Origin: http://localhost:3000

> {%
  client.test("Status is 200", function () {
    client.assert(response.status === 200, "Expected 200 OK");
  });
  client.test("CORS headers present", function () {
    client.assert(
      response.headers.valueOf("Access-Control-Allow-Origin") ===
        "http://localhost:3000",
      "Should allow localhost:3000",
    );
  });
%}


### 


### CORS Request - Unauthorized Origin

# Browser would block this, but server responds
# (HTTP client doesn't enforce CORS like browsers do)

GET {{host}}/posts HTTP/1.1
Origin: http://malicious-site.com

> {%
  client.test("Server responds", function () {
    client.assert(response.status === 200, "Server should respond");
  });
  client.test("No CORS header for unauthorized origin", function () {
    var allowOrigin = response.headers.valueOf("Access-Control-Allow-Origin");
    if (allowOrigin) {
      client.assert(
        allowOrigin !== "http://malicious-site.com",
        "Should not return unauthorized origin",
      );
    }
  });
  client.log("Note: Browser would block this response due to CORS policy");
%}


### 


### 3. CSRF DEMO ENDPOINTS


### 


### Get CSRF Token Info

# Demonstrates why CSRF is disabled for JWT APIs

GET {{host}}/csrf-demo/token HTTP/1.1
Authorization: {{adminAuth}}

> {%
  client.test("Status is 200", function () {
    client.assert(response.status === 200, "Expected 200 OK");
  });
  client.test("Response explains CSRF is disabled", function () {
    client.assert(response.body.csrfEnabled === false, "CSRF should be disabled");
    client.assert(response.body.message, "Should have explanatory message");
  });
%}


### 


### Submit Form Without CSRF Token

# Demonstrates form submission without CSRF protection

POST {{host}}/csrf-demo/submit-form?message=Testing CSRF demo HTTP/1.1

> {%
  client.test("Status is 200", function () {
    client.assert(response.status === 200, "Expected 200 OK");
  });
  client.test("Form submission succeeds", function () {
    client.assert(
      response.body.success === true,
      "Should succeed without CSRF token",
    );
    client.assert(response.body.note, "Should include educational note");
  });
%}


### 


### Get CSRF vs CORS Info

# Comprehensive explanation of security concepts

GET {{host}}/csrf-demo/info HTTP/1.1

> {%
  client.test("Status is 200", function () {
    client.assert(response.status === 200, "Expected 200 OK");
  });
  client.test("Detailed security info present", function () {
    client.assert(response.body.rationale, "Should explain rationale");
    client.assert(
      response.body.alternativeSecurity,
      "Should explain alternatives",
    );
    client.assert(
      response.body.whenToEnableCsrf,
      "Should explain when to enable",
    );
    client.assert(response.body.howToEnableCsrf, "Should explain how to enable");
  });
%}


### 


### 5. ROLE-BASED ACCESS CONTROL (RBAC)


### Reader Endpoint - Requires READER, AUTHOR, or ADMIN Role

# Any authenticated user with a role should have access

GET {{host}}/reader/bookmarks HTTP/1.1
Authorization: {{readerAuth}}

> {%
  client.test("Status is 200, 403, or 404", function () {
    var validStatuses = [200, 403, 404];
    client.assert(
      validStatuses.includes(response.status),
      "Expected 200/403/404",
    );
  });
  if (response.status === 200) {
    client.log("✓ Access granted: User is authenticated");
  } else if (response.status === 403) {
    client.log("✗ Access denied");
  } else if (response.status === 404) {
    client.log("⚠ Endpoint not yet implemented");
  }
%}
