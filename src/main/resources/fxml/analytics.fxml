<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.AnalyticsController"
  fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
  stylesheets="@../css/theme.css">

  <VBox spacing="30" style="-fx-background-color: transparent;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
      <VBox spacing="5">
        <Label text="Analytics And Performance"
          style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        <Label text="Track your blog's metrics and insights"
          styleClass="subtitle-text" style="-fx-font-size: 14px;" />
      </VBox>
      <Region HBox.hgrow="ALWAYS" />
      <ComboBox fx:id="timeRangeCombo" promptText="Last 30 days"
        prefWidth="150" styleClass="modern-combo-box" />
      <Button fx:id="exportReportBtn" text="📊 Export Report"
        styleClass="primary-button" />
    </HBox>

    <!-- Key Metrics -->
    <GridPane hgap="20" vgap="20">
      <columnConstraints>
        <ColumnConstraints percentWidth="33.33" />
        <ColumnConstraints percentWidth="33.33" />
        <ColumnConstraints percentWidth="33.33" />
      </columnConstraints>

      <VBox spacing="12" styleClass="card" GridPane.columnIndex="0"
        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, -primary-color 0%, -primary-color-dimmed 100%); 
               -fx-padding: 24; -fx-background-radius: 16;">
        <Label text="👁️" style="-fx-font-size: 24px;" />
        <Label text="Total Views" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);" />
        <Label fx:id="totalViewsLabel" text="0"
          style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        <Label fx:id="viewsChangeLabel" text="+0% from last period"
          style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);" />
      </VBox>

      <VBox spacing="12" styleClass="card" GridPane.columnIndex="1"
        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #10b981 0%, #059669 100%); 
               -fx-padding: 24; -fx-background-radius: 16;">
        <Label text="📈" style="-fx-font-size: 24px;" />
        <Label text="Engagement Rate"
          style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);" />
        <Label fx:id="engagementLabel" text="0%"
          style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        <Label fx:id="engagementChangeLabel" text="+0% from last period"
          style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);" />
      </VBox>

      <VBox spacing="12" styleClass="card" GridPane.columnIndex="2"
        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f59e0b 0%, #d97706 100%); 
               -fx-padding: 24; -fx-background-radius: 16;">
        <Label text="⏱️" style="-fx-font-size: 24px;" />
        <Label text="Avg. Read Time"
          style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);" />
        <Label fx:id="avgReadTimeLabel" text="0 min"
          style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        <Label fx:id="readTimeChangeLabel" text="+0% from last period"
          style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);" />
      </VBox>
    </GridPane>

    <!-- Views Chart -->
    <VBox spacing="20" styleClass="card" style="-fx-padding: 30; -fx-background-radius: 16;">
      <Label text="📊 Views Over Time"
        style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
      <LineChart fx:id="viewsChart" prefHeight="350" legendVisible="false">
        <xAxis>
          <CategoryAxis label="Date" />
        </xAxis>
        <yAxis>
          <NumberAxis label="Views" />
        </yAxis>
      </LineChart>
    </VBox>

    <!-- Two Column Layout -->
    <GridPane hgap="24" vgap="24">
      <columnConstraints>
        <ColumnConstraints percentWidth="50" />
        <ColumnConstraints percentWidth="50" />
      </columnConstraints>

      <!-- Top Posts -->
      <VBox spacing="20" styleClass="card" GridPane.columnIndex="0"
        style="-fx-padding: 30; -fx-background-radius: 16;">
        <Label text="🏆 Top Performing Posts"
          style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        <TableView fx:id="topPostsTable" prefHeight="300"
          style="-fx-background-color: transparent;">
          <columns>
            <TableColumn fx:id="topPostTitleColumn" text="Post Title" prefWidth="220" />
            <TableColumn fx:id="topPostViewsColumn" text="Views" prefWidth="80" />
            <TableColumn fx:id="topPostCommentsColumn" text="Comments" prefWidth="90" />
          </columns>
        </TableView>
      </VBox>

      <!-- Tag Performance -->
      <VBox spacing="20" styleClass="card" GridPane.columnIndex="1"
        style="-fx-padding: 30; -fx-background-radius: 16;">
        <Label text="🏷️ Tag Performance"
          style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        <PieChart fx:id="tagPerformanceChart" prefHeight="300" legendVisible="true" />
      </VBox>
    </GridPane>

    <!-- Performance Metrics -->
    <VBox spacing="20" styleClass="card" style="-fx-padding: 30; -fx-background-radius: 16;">
      <Label text="⚡ Database Performance"
        style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

      <GridPane hgap="30" vgap="15" style="-fx-padding: 15 0;">
        <Label text="Query Type" styleClass="field-label"
          GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <Label text="Before" styleClass="field-label"
          GridPane.rowIndex="0" GridPane.columnIndex="1" />
        <Label text="After" styleClass="field-label"
          GridPane.rowIndex="0" GridPane.columnIndex="2" />
        <Label text="Improvement" styleClass="field-label"
          GridPane.rowIndex="0" GridPane.columnIndex="3" />

        <Label fx:id="searchQueryLabel" text="Post Search" GridPane.rowIndex="1"
          GridPane.columnIndex="0" />
        <Label fx:id="searchBeforeLabel" text="0 ms" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        <Label fx:id="searchAfterLabel" text="0 ms" GridPane.rowIndex="1" GridPane.columnIndex="2" />
        <Label fx:id="searchImprovementLabel" text="0%" GridPane.rowIndex="1"
          GridPane.columnIndex="3" styleClass="success-text" />

        <Label fx:id="listQueryLabel" text="Post Listing" GridPane.rowIndex="2"
          GridPane.columnIndex="0" />
        <Label fx:id="listBeforeLabel" text="0 ms" GridPane.rowIndex="2" GridPane.columnIndex="1" />
        <Label fx:id="listAfterLabel" text="0 ms" GridPane.rowIndex="2" GridPane.columnIndex="2" />
        <Label fx:id="listImprovementLabel" text="0%" GridPane.rowIndex="2" GridPane.columnIndex="3"
          styleClass="success-text" />
      </GridPane>

      <HBox spacing="15" alignment="CENTER_LEFT">
        <Button fx:id="runBenchmarkBtn" text="🚀 Run Performance Test" styleClass="primary-button" />
        <Label fx:id="benchmarkStatusLabel" styleClass="info-text" />
      </HBox>
    </VBox>
  </VBox>
</ScrollPane>
