<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.CategoryManagementController"
  fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
  stylesheets="@../css/theme.css">

  <VBox spacing="30" style="-fx-background-color: transparent;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
      <VBox spacing="5">
        <Label text="Category Management"
          style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        <Label text="Organize your posts into categories"
          styleClass="subtitle-text" style="-fx-font-size: 14px;" />
      </VBox>
      <Region HBox.hgrow="ALWAYS" />
      <Button fx:id="createCategoryBtn" text="➕ Create Category" onAction="#showCreateForm"
        styleClass="primary-button-large" />
    </HBox>

    <!-- Create/Edit Form -->
    <VBox fx:id="categoryFormContainer" spacing="20" styleClass="card"
      style="-fx-padding: 30; -fx-background-radius: 16;" managed="false" visible="false">

      <Label fx:id="formTitleLabel" text="Create New Category"
        style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

      <!-- Category Name -->
      <VBox spacing="10">
        <Label text="Category Name *" styleClass="field-label" />
        <TextField fx:id="categoryNameField" promptText="Enter category name (e.g., Technology, Travel)"
          styleClass="modern-text-field" />
        <Label fx:id="slugPreviewLabel" text="Slug: will-be-generated-automatically"
          style="-fx-font-size: 12px; -fx-text-fill: #6b7280;" />
      </VBox>

      <!-- Description -->
      <VBox spacing="10">
        <Label text="Description *" styleClass="field-label" />
        <TextArea fx:id="categoryDescriptionArea" promptText="Enter category description..."
          prefHeight="100" wrapText="true"
          style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; 
                 -fx-border-width: 2px; -fx-border-radius: 8px; 
                 -fx-background-radius: 8px; -fx-padding: 12; -fx-font-size: 14px;" />
      </VBox>

      <!-- Actions -->
      <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="cancelFormBtn" text="Cancel" onAction="#hideCreateForm" styleClass="outline" />
        <Button fx:id="saveCategoryBtn" text="Save Category" onAction="#handleSaveCategory" styleClass="success-button" />
      </HBox>
    </VBox>

    <!-- Statistics Cards -->
    <HBox spacing="20">
      <VBox spacing="10" styleClass="stat-card" HBox.hgrow="ALWAYS"
        style="-fx-padding: 20; -fx-background-color: #f0f9ff; -fx-background-radius: 12;">
        <Label text="Total Categories"
          style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
        <Label fx:id="totalCategoriesLabel" text="0"
          style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0369a1;" />
      </VBox>
      
      <VBox spacing="10" styleClass="stat-card" HBox.hgrow="ALWAYS"
        style="-fx-padding: 20; -fx-background-color: #f0fdf4; -fx-background-radius: 12;">
        <Label text="Most Popular"
          style="-fx-font-size: 14px; -fx-text-fill: #64748b;" />
        <Label fx:id="popularCategoryLabel" text="-"
          style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #15803d;" />
      </VBox>
    </HBox>

    <!-- Categories Table -->
    <VBox spacing="20" VBox.vgrow="ALWAYS" styleClass="card"
      style="-fx-padding: 30; -fx-background-radius: 16;">
      
      <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="All Categories"
          style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="searchField" promptText="🔍 Search categories..."
          prefWidth="300" styleClass="modern-text-field" />
      </HBox>

      <TableView fx:id="categoriesTable" prefHeight="400" VBox.vgrow="ALWAYS"
        style="-fx-background-color: white; -fx-table-cell-border-color: #e5e7eb;">
        
        <columns>
          <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
          <TableColumn fx:id="nameColumn" text="Name" prefWidth="200" />
          <TableColumn fx:id="slugColumn" text="Slug" prefWidth="200" />
          <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300" />
          <TableColumn fx:id="postCountColumn" text="Posts" prefWidth="80" />
          <TableColumn fx:id="createdAtColumn" text="Created" prefWidth="150" />
          <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="180" />
        </columns>

        <placeholder>
          <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
            <Label text="📁" style="-fx-font-size: 48px;" />
            <Label text="No categories found"
              style="-fx-font-size: 16px; -fx-text-fill: #6b7280;" />
            <Label text="Create your first category to get started"
              style="-fx-font-size: 14px; -fx-text-fill: #9ca3af;" />
          </VBox>
        </placeholder>
      </TableView>
    </VBox>
  </VBox>
</ScrollPane>
