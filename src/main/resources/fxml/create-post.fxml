<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Scene?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.CreatePostController" fitToWidth="true"
  style="-fx-background-color: transparent;"
  stylesheets="@../css/enhanced-theme.css">

  <VBox spacing="25" style="-fx-padding: 20;">
    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
      <Label fx:id="headerLabel" text="Create New Post"
        style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333;" />
      <Region HBox.hgrow="ALWAYS" />
      <Button fx:id="saveAsDraftBtn" text="💾 Save as Draft" styleClass="secondary-button" />
      <Button fx:id="publishBtn" text="🚀 Publish" styleClass="success-button" />
    </HBox>

    <!-- Form Content -->
    <VBox spacing="20"
      style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

      <!-- Title -->
      <VBox spacing="8">
        <Label text="Post Title *" styleClass="field-label-required" />
        <TextField fx:id="titleField" promptText="Enter an engaging title for your post"
          prefWidth="700" styleClass="modern-text-field" />
      </VBox>

      <!-- Content -->
      <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="Content *" styleClass="field-label-required" />
        <TextArea fx:id="contentArea" promptText="Write your blog post content here..."
          prefHeight="400" wrapText="true" styleClass="modern-text-area" />
        <Label fx:id="wordCountLabel" text="0 words" styleClass="word-count-label" />
      </VBox>

      <!-- Tags -->
      <VBox spacing="8">
        <Label text="Tags" styleClass="field-label" />
        <HBox spacing="10" alignment="CENTER_LEFT">
          <TextField fx:id="tagInputField" promptText="Add tags (press Enter)" prefWidth="500" styleClass="modern-text-field" />
          <Button fx:id="addTagBtn" text="+ Add Tag" styleClass="primary-button" />
        </HBox>
        <FlowPane fx:id="tagsFlowPane" hgap="10" vgap="10" style="-fx-padding: 10 0;" />
      </VBox>

      <!-- Category -->
      <VBox spacing="8">
        <Label text="Category" styleClass="field-label" />
        <ComboBox fx:id="categoryComboBox" prefWidth="300" styleClass="modern-combo-box" />
      </VBox>

      <!-- Excerpt -->
      <VBox spacing="8">
        <Label text="Excerpt (Optional)" styleClass="field-label" />
        <TextArea fx:id="excerptArea" promptText="Write a brief summary (shown in post previews)"
          prefHeight="100" wrapText="true" styleClass="modern-text-area" />
      </VBox>

      <!-- Featured Image -->
      <VBox spacing="8">
        <Label text="Featured Image (Optional)" styleClass="field-label" />
        <HBox spacing="10" alignment="CENTER_LEFT">
          <TextField fx:id="imageUrlField" promptText="Enter image URL" prefWidth="500" styleClass="modern-text-field" />
          <Button fx:id="uploadImageBtn" text="📁 Browse" styleClass="secondary-button" />
        </HBox>
      </VBox>

      <!-- Error/Success Message -->
      <Label fx:id="messageLabel" wrapText="true" styleClass="info-text" />
    </VBox>

    <!-- Action Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
      <Button fx:id="cancelBtn" text="Cancel" styleClass="outline-button" />
      <Button fx:id="previewBtn" text="👁️ Preview" styleClass="info-button" />
    </HBox>
  </VBox>
</ScrollPane>
