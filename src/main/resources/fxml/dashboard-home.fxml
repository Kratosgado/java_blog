<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.DashboardHomeController"
  fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
  stylesheets="@../css/theme.css">

  <VBox spacing="30" style="-fx-background-color: transparent;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
      <VBox spacing="5">
        <Label text="Dashboard Overview"
          style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        <Label text="Monitor your blog's performance and activity"
          styleClass="subtitle-text" style="-fx-font-size: 14px;" />
      </VBox>
    </HBox>

    <!-- Statistics Cards -->
    <GridPane hgap="20" vgap="20">
      <columnConstraints>
        <ColumnConstraints percentWidth="25" />
        <ColumnConstraints percentWidth="25" />
        <ColumnConstraints percentWidth="25" />
        <ColumnConstraints percentWidth="25" />
      </columnConstraints>

      <!-- Total Posts Card -->
      <VBox spacing="12" styleClass="card" GridPane.columnIndex="0"
        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #667eea 0%, #764ba2 100%); 
               -fx-padding: 24; -fx-background-radius: 16;">
        <Label text="📝" style="-fx-font-size: 24px;" />
        <Label text="Total Posts" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);" />
        <Label fx:id="totalPostsLabel" text="0"
          style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        <Label text="Published articles"
          style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);" />
      </VBox>

      <!-- Total Comments Card -->
      <VBox spacing="12" styleClass="card" GridPane.columnIndex="1"
        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #10b981 0%, #059669 100%); 
               -fx-padding: 24; -fx-background-radius: 16;">
        <Label text="💬" style="-fx-font-size: 24px;" />
        <Label text="Comments" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);" />
        <Label fx:id="totalCommentsLabel" text="0"
          style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        <Label text="User interactions"
          style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);" />
      </VBox>

      <!-- Total Views Card -->
      <VBox spacing="12" styleClass="card" GridPane.columnIndex="2"
        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #f59e0b 0%, #d97706 100%); 
               -fx-padding: 24; -fx-background-radius: 16;">
        <Label text="👁️" style="-fx-font-size: 24px;" />
        <Label text="Total Views" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);" />
        <Label fx:id="totalViewsLabel" text="0"
          style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        <Label text="Post impressions"
          style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);" />
      </VBox>

      <!-- Active Tags Card -->
      <VBox spacing="12" styleClass="card" GridPane.columnIndex="3"
        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #ec4899 0%, #be185d 100%); 
               -fx-padding: 24; -fx-background-radius: 16;">
        <Label text="🏷️" style="-fx-font-size: 24px;" />
        <Label text="Active Tags" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.9);" />
        <Label fx:id="totalTagsLabel" text="0"
          style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
        <Label text="Categories used"
          style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);" />
      </VBox>
    </GridPane>

    <!-- Recent Posts Section -->
    <VBox spacing="20" styleClass="card" style="-fx-padding: 30; -fx-background-radius: 16;">
      <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="📚 Recent Posts"
          style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="View All Posts" onAction="#viewAllPosts" styleClass="primary-button" />
      </HBox>

      <ScrollPane fitToWidth="true" prefHeight="400"
        style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox fx:id="recentPostsContainer" spacing="12" />
      </ScrollPane>
    </VBox>
  </VBox>
</ScrollPane>
