<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.DashboardController"
  style="-fx-background-color: #f5f7fa;"
  stylesheets="@../css/theme.css">

  <!-- Top Navigation Bar -->
  <top>
    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="nav-bar" style="-fx-padding: 20 40;">
      <Label fx:id="titleLabel" text="✍️ Blog Hub" styleClass="nav-title" 
        style="-fx-cursor: hand;" />
      <Region HBox.hgrow="ALWAYS" />
      
      <TextField fx:id="searchField" promptText="🔍 Search..." 
        prefWidth="300" styleClass="modern-text-field" />
      
      <Label fx:id="userLabel" styleClass="subtitle-text" 
        style="-fx-font-size: 14px; -fx-font-weight: 600;" />
      
      <Button fx:id="logoutBtn" text="Logout" styleClass="danger-button" />
    </HBox>
  </top>

  <!-- Left Sidebar Navigation -->
  <left>
    <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 24 16; -fx-pref-width: 240; 
      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 2, 0);">
      
      <Label text="DASHBOARD" 
        style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-font-weight: bold; -fx-padding: 12 8;" />
      
      <Button fx:id="dashboardBtn" text="📊 Overview" prefWidth="200" 
        alignment="CENTER_LEFT" styleClass="nav-button" 
        style="-fx-background-color: -primary-color; -fx-text-fill: white;" />
      
      <Button fx:id="postsBtn" text="📝 My Posts" prefWidth="200" 
        alignment="CENTER_LEFT" styleClass="nav-button" />
      
      <Button fx:id="createPostBtn" text="➕ Create Post" prefWidth="200" 
        alignment="CENTER_LEFT" styleClass="nav-button" />
      
      <Button fx:id="commentsBtn" text="💬 Comments" prefWidth="200" 
        alignment="CENTER_LEFT" styleClass="nav-button" />
      
      <Button fx:id="tagsBtn" text="🏷️ Tags" prefWidth="200" 
        alignment="CENTER_LEFT" styleClass="nav-button" />
      
      <Button fx:id="analyticsBtn" text="📈 Analytics" prefWidth="200" 
        alignment="CENTER_LEFT" styleClass="nav-button" />
      
      <Separator style="-fx-padding: 12 0;" />
      
      <Label text="ACCOUNT" 
        style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-font-weight: bold; -fx-padding: 12 8;" />
      
      <Button fx:id="profileBtn" text="👤 Profile" prefWidth="200" 
        alignment="CENTER_LEFT" styleClass="nav-button" />
      
      <Button fx:id="settingsBtn" text="⚙️ Settings" prefWidth="200" 
        alignment="CENTER_LEFT" styleClass="nav-button" />
    </VBox>
  </left>

  <!-- Center Content Area -->
  <center>
    <StackPane fx:id="contentArea" style="-fx-padding: 30;">
      <!-- Dynamic content loaded here -->
    </StackPane>
  </center>
</BorderPane>
