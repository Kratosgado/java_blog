<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.ProgressIndicator?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.HomeController"
  style="-fx-background-color: #f5f7fa;"
  stylesheets="@../css/enhanced-theme.css">

  <!-- Top Navigation Bar -->
  <top>
    <HBox alignment="CENTER_LEFT" spacing="20"
      style="-fx-background-color: white; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
      <Label text="📝 Blog"
        style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #667eea;" />

      <Region HBox.hgrow="ALWAYS" />

      <VBox spacing="5">
        <Label text="Search posts..." styleClass="field-label" />
        <TextField fx:id="searchField" prefWidth="300" styleClass="modern-text-field" />
      </VBox>
      <VBox spacing="5">
        <Label text="Category" styleClass="field-label" />
        <ComboBox fx:id="categoryComboBox" prefWidth="150" styleClass="modern-combo-box" />
      </VBox>
      <VBox spacing="5">
        <Label text="Sort By" styleClass="field-label" />
        <ComboBox fx:id="sortComboBox" prefWidth="150" styleClass="modern-combo-box" />
      </VBox>

      <HBox fx:id="authSection" spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="loginBtn" text="Sign In" styleClass="primary-button" />

        <Button fx:id="signupBtn" text="Sign Up" styleClass="success-button" />
      </HBox>

      <HBox fx:id="userSection" spacing="10" alignment="CENTER_RIGHT" visible="false"
        managed="false">
        <Label fx:id="userLabel" text="Welcome, User"
          styleClass="subtitle-text" />

        <Button fx:id="userMenuBtn" text="👤" styleClass="icon-button" />
      </HBox>
    </HBox>
  </top>

  <!-- Main Content Area -->
  <center>
    <StackPane style="-fx-background-color: transparent;">
      <!-- Loading Overlay -->
      <HBox fx:id="loadingContainer" alignment="CENTER"
        style="-fx-background-color: rgba(255,255,255,0.9); -fx-padding: 50;" visible="false"
        managed="false">
        <ProgressIndicator prefWidth="40" prefHeight="40" style="-fx-progress-color: #667eea;" />
        <Label text="Loading..."
          style="-fx-font-size: 16px; -fx-text-fill: #666; -fx-padding: 10 0 0 10;" />
      </HBox>

      <!-- Main Content -->
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox spacing="20" style="-fx-padding: 20;">

          <!-- Featured Posts Slider -->
          <VBox spacing="15" style="-fx-padding: 0 20 20 20;">
            <Label text="🌟 Featured Posts"
              style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

            <ScrollPane fx:id="featuredScrollPane" fitToWidth="true" hbarPolicy="NEVER"
              style="-fx-background-color: transparent; -fx-padding: 10;">
              <HBox fx:id="featuredPostsContainer" spacing="20" alignment="CENTER_LEFT" />
            </ScrollPane>
          </VBox>

          <!-- Main Content Area -->
          <HBox spacing="20" VBox.vgrow="ALWAYS" style="-fx-padding: 0 20 20 20;">

            <!-- Blog Posts Feed -->
            <VBox spacing="20" HBox.hgrow="ALWAYS">
              <HBox alignment="CENTER_LEFT" spacing="15">
                <Label fx:id="postsCountLabel" text="Latest Posts" styleClass="section-title" />
                <Region HBox.hgrow="ALWAYS" />
                <ToggleButton fx:id="gridViewBtn" text="⊞" styleClass="toggle-button-active" />
                <ToggleButton fx:id="listViewBtn" text="☰" styleClass="toggle-button" />
              </HBox>

              <!-- Posts Container -->
              <ScrollPane fx:id="postsScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                vbarPolicy="ALWAYS"
                style="-fx-background-color: transparent;">
                <VBox fx:id="postsContainer" spacing="15" />
              </ScrollPane>

              <!-- Load More Button -->
              <HBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                <Button fx:id="loadMoreBtn" text="Load More Posts" styleClass="primary-button-large" />
              </HBox>
            </VBox>

            <!-- Sidebar -->
            <VBox spacing="20" prefWidth="300">

              <!-- Categories Widget -->
              <VBox spacing="15"
                style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label text="📂 Categories"
                  style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <VBox fx:id="categoriesContainer" spacing="8" />
              </VBox>

              <!-- Popular Tags -->
              <VBox spacing="15"
                style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label text="🏷️ Popular Tags"
                  style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <FlowPane fx:id="popularTagsContainer" hgap="8" vgap="8" />
              </VBox>

              <!-- Recent Activity -->
              <VBox spacing="15"
                style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label text="🔥 Trending Now"
                  style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <VBox fx:id="trendingContainer" spacing="10" />
              </VBox>
            </VBox>
          </HBox>
        </VBox>
      </ScrollPane>
    </StackPane>
  </center>
</BorderPane>
