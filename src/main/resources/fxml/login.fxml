<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.LoginController"
  stylesheets="@../css/modern-ui.css"
  style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
  
  <VBox alignment="CENTER" maxWidth="450" styleClass="card" 
    style="-fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 30, 0, 0, 10);">
    <padding>
      <Insets top="50" right="50" bottom="50" left="50" />
    </padding>

    <!-- Header -->
    <VBox alignment="CENTER" spacing="10">
      <Label text="✍️" style="-fx-font-size: 48px;" />
      <Label text="Welcome Back" styleClass="title" style="-fx-font-size: 36px;" />
      <Label text="Sign in to continue to Blog Hub" styleClass="subtitle-text" 
        style="-fx-font-size: 16px;" />
    </VBox>

    <Region prefHeight="40" />

    <!-- Email Field -->
    <VBox spacing="8">
      <Label text="Email Address" styleClass="field-label" />
      <TextField fx:id="emailField" prefWidth="350" 
        promptText="Enter your email" styleClass="modern-text-field" />
    </VBox>

    <!-- Password Field -->
    <VBox spacing="8">
      <Label text="Password" styleClass="field-label" />
      <PasswordField fx:id="passwordField" prefWidth="350" 
        promptText="Enter your password" styleClass="modern-text-field" />
    </VBox>

    <!-- Error Label -->
    <Label fx:id="infoLabel" wrapText="true" maxWidth="350" styleClass="error" 
      style="-fx-min-height: 20;" />

    <Region prefHeight="10" />

    <!-- Login Button -->
    <Button fx:id="loginButton" text="Sign In" prefWidth="350" 
      styleClass="primary-button-large" />

    <Region prefHeight="20" />

    <!-- Sign Up Link -->
    <HBox alignment="CENTER" spacing="8">
      <Label text="Don't have an account?" styleClass="muted-text" />
      <Button fx:id="signUpLink" text="Create Account" styleClass="link-button" 
        style="-fx-font-size: 14px; -fx-font-weight: 600;" />
    </HBox>
  </VBox>
</StackPane>
