<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.LoginController"
  stylesheets="@../css/enhanced-theme.css"
  style="-fx-background-color: #f9fafb;">
  <VBox alignment="CENTER" maxWidth="400" styleClass="card">
    <padding>
      <Insets top="40" right="40" bottom="40" left="40" />
    </padding>

    <Label text="Welcome Back" styleClass="title" />

    <VBox spacing="8">
      <Label text="Email" styleClass="caption" />
      <TextField fx:id="emailField" prefWidth="320" promptText="Enter your email" />
    </VBox>

    <VBox spacing="8">
      <Label text="Password" styleClass="caption" />
      <PasswordField fx:id="passwordField" prefWidth="320" promptText="Enter your password" />
    </VBox>

    <Label fx:id="infoLabel" wrapText="true" maxWidth="320" styleClass="error" />

    <Button fx:id="loginButton" text="Login" prefWidth="320" styleClass="button" />

    <HBox alignment="CENTER" spacing="5">
      <Label text="Don't have an account?" />
      <Button fx:id="signUpLink" text="Sign Up" styleClass="button, outline" />
    </HBox>
  </VBox>
</StackPane>
