<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.PostsListController"
  fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
  stylesheets="@../css/theme.css">

  <VBox spacing="25" style="-fx-background-color: transparent;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
      <VBox spacing="5">
        <Label text="My Blog Posts"
          style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        <Label text="Manage and organize your content"
          styleClass="subtitle-text" style="-fx-font-size: 14px;" />
      </VBox>
      <Region HBox.hgrow="ALWAYS" />
      <Button fx:id="createNewPostBtn" text="➕ New Post" styleClass="primary-button-large" />
    </HBox>

    <!-- Filters & Search -->
    <HBox spacing="20" styleClass="card" style="-fx-padding: 24; -fx-background-radius: 16;">
      <VBox spacing="8" HBox.hgrow="ALWAYS">
        <Label text="Search" styleClass="field-label" />
        <TextField fx:id="searchField" promptText="Search by title, content, or tags..."
          styleClass="modern-text-field" />
      </VBox>

      <VBox spacing="8">
        <Label text="Status" styleClass="field-label" />
        <ComboBox fx:id="filterComboBox" prefWidth="150" styleClass="modern-combo-box" />
      </VBox>

      <VBox spacing="8">
        <Label text="Sort By" styleClass="field-label" />
        <ComboBox fx:id="sortComboBox" prefWidth="150" styleClass="modern-combo-box" />
      </VBox>

      <VBox spacing="8" alignment="BOTTOM_CENTER">
        <HBox spacing="10">
          <Button fx:id="searchBtn" text="🔍 Search" styleClass="primary-button" />
          <Button fx:id="clearBtn" text="Clear" styleClass="outline" />
        </HBox>
      </VBox>
    </HBox>

    <!-- Posts Table -->
    <VBox spacing="0" VBox.vgrow="ALWAYS" styleClass="card"
      style="-fx-padding: 24; -fx-background-radius: 16;">

      <!-- Table Header Info -->
      <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 15 0;">
        <Label fx:id="totalPostsLabel" text="0 posts"
          style="-fx-font-size: 13px; -fx-text-fill: #6b7280; -fx-font-weight: 600;" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Showing results"
          style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;" />
      </HBox>

      <TableView fx:id="postsTable" VBox.vgrow="ALWAYS"
        style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-table-cell-border-color: #f3f4f6;">
        <columns>
          <TableColumn fx:id="titleColumn" text="Title" prefWidth="280" minWidth="200" 
            style="-fx-alignment: CENTER_LEFT;" />
          <TableColumn fx:id="authorColumn" text="Author" prefWidth="140" minWidth="100"
            style="-fx-alignment: CENTER_LEFT;" />
          <TableColumn fx:id="dateColumn" text="Published" prefWidth="130" minWidth="110"
            style="-fx-alignment: CENTER;" />
          <TableColumn fx:id="viewsColumn" text="Views" prefWidth="90" minWidth="80"
            style="-fx-alignment: CENTER;" />
          <TableColumn fx:id="statusColumn" text="Status" prefWidth="110" minWidth="100"
            style="-fx-alignment: CENTER;" />
          <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="180" minWidth="160"
            style="-fx-alignment: CENTER;" sortable="false" />
        </columns>
        <placeholder>
          <VBox alignment="CENTER" spacing="15" style="-fx-padding: 60;">
            <Label text="No posts found"
              style="-fx-font-size: 18px; -fx-font-weight: 600; -fx-text-fill: #6b7280;" />
            <Label text="Create your first post to get started"
              style="-fx-font-size: 14px; -fx-text-fill: #9ca3af;" />
            <Button text="Create New Post" styleClass="primary-button"
              onAction="#createNewPost" />
          </VBox>
        </placeholder>
      </TableView>

      <!-- Pagination -->
      <Separator style="-fx-padding: 15 0;" />
      <HBox alignment="CENTER" spacing="15">
        <Button fx:id="prevPageBtn" text="← Previous" styleClass="outline"
          style="-fx-padding: 8 20; -fx-font-size: 13px;" />
        <Label fx:id="pageLabel" text="Page 1 of 1"
          style="-fx-font-size: 14px; -fx-text-fill: #111827; -fx-font-weight: 600;" />
        <Button fx:id="nextPageBtn" text="Next →" styleClass="outline"
          style="-fx-padding: 8 20; -fx-font-size: 13px;" />
      </HBox>
    </VBox>
  </VBox>
</ScrollPane>
