<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.PostViewController" fitToWidth="true"
  style="-fx-background-color: #f5f7fa;"
  stylesheets="@../css/theme.css">

  <VBox spacing="20" style="-fx-padding: 20;">

    <!-- Navigation Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15"
      style="-fx-background-color: white; -fx-padding: 15 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
      <Button fx:id="backBtn" text="← Back" styleClass="back-button" />
      <Separator orientation="VERTICAL" prefHeight="30" />
      <Label fx:id="categoryLabel" text="Technology" styleClass="category-label" />
      <Region HBox.hgrow="ALWAYS" />
      <Button fx:id="shareBtn" text="🔗 Share" styleClass="success-button" />
      <Button fx:id="bookmarkBtn" text="🔖 Save" styleClass="warning-button" />
    </HBox>

    <!-- Main Content Area -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">

      <!-- Post Content -->
      <VBox spacing="25" HBox.hgrow="ALWAYS"
        style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

        <!-- Post Header -->
        <VBox spacing="15">
          <Label fx:id="postTitleLabel" text="Loading Post..." styleClass="post-title"
            wrapText="true" />

          <!-- Author Info -->
          <HBox spacing="15" alignment="CENTER_LEFT">
            <ImageView fx:id="authorAvatar" fitWidth="48" fitHeight="48" preserveRatio="true"
              style="-fx-background-radius: 24; -fx-border-radius: 24; -fx-border-color: #e0e0e0; -fx-border-width: 2;" />

            <VBox spacing="3">
              <Label fx:id="authorLabel" text="Author Name" styleClass="author-name" />
              <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="dateLabel" text="Published Date" styleClass="post-meta" />
                <Separator orientation="VERTICAL" prefHeight="15" />
                <Label fx:id="readTimeLabel" text="5 min read" styleClass="post-meta" />
              </HBox>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="followAuthorBtn" text="Follow" styleClass="follow-button" />
          </HBox>

          <!-- Tags -->
          <FlowPane fx:id="tagsFlowPane" hgap="8" vgap="8" />
        </VBox>

        <Separator style="-fx-opacity: 0.3;" />

        <!-- Featured Image -->
        <ImageView fx:id="featuredImage" fitWidth="800" fitHeight="400" preserveRatio="true"
          style="-fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 5, 0, 0, 2);" />

        <!-- Post Content -->
        <Label fx:id="contentLabel"
          style="-fx-background-color: transparent; -fx-border-color: transparent;" />

        <!-- Post Engagement Bar -->
        <HBox spacing="20" alignment="CENTER" styleClass="engagement-bar">
          <Button fx:id="likeBtn" text="👍 42" styleClass="engagement-button" />
          <Button fx:id="dislikeBtn" text="👎 2" styleClass="engagement-button" />
          <Button fx:id="commentBtn" text="💬 15 Comments" styleClass="engagement-button" />

          <Region HBox.hgrow="ALWAYS" />

          <Label fx:id="viewsLabel" text="👁️ 1,234 views" styleClass="views-label" />
        </HBox>

        <!-- Author Actions -->
        <HBox spacing="15" alignment="CENTER_LEFT" fx:id="authorActionsContainer">
          <Button fx:id="editPostBtn" text="✏️ Edit" styleClass="info-button" />
          <Button fx:id="deletePostBtn" text="🗑️ Delete" styleClass="danger-button" />
          <Button fx:id="publishBtn" text="📢 Publish" styleClass="success-button" />
        </HBox>
      </VBox>

      <!-- Sidebar -->
      <VBox spacing="20" prefWidth="300">

        <!-- Table of Contents -->
        <VBox fx:id="tableOfContentsContainer" spacing="15"
          style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
          <Label text="📋 Table of Contents" styleClass="section-title" />
          <VBox fx:id="tocContainer" spacing="8" />
        </VBox>

        <!-- Related Posts -->
        <VBox spacing="15"
          style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
          <Label text="🔗 Related Posts" styleClass="section-title" />
          <VBox fx:id="relatedPostsContainer" spacing="12" />
        </VBox>

        <!-- Author Bio -->
        <VBox spacing="15"
          style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
          <Label text="👤 About the Author" styleClass="section-title" />

          <HBox spacing="12" alignment="CENTER_LEFT">
            <ImageView fx:id="sidebarAuthorAvatar" fitWidth="40" fitHeight="40" preserveRatio="true"
              style="-fx-background-radius: 20;" />
            <VBox spacing="2">
              <Label fx:id="sidebarAuthorLabel" text="Author Name" styleClass="author-name" />
              <Label fx:id="sidebarAuthorStats" text="42 posts • 1.2k followers"
                styleClass="author-stats" />
            </VBox>
          </HBox>

          <Label fx:id="authorBioLabel" text="Author bio will appear here..."
            styleClass="author-bio" wrapText="true" />
        </VBox>
      </VBox>
    </HBox>

    <!-- Comments Section -->
    <VBox spacing="20"
      style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
      <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="💬 Comments" styleClass="section-title" />
        <Label fx:id="commentsCountLabel" text="(15)" styleClass="comments-count" />
        <Region HBox.hgrow="ALWAYS" />
        <VBox spacing="5">
          <Label text="Sort" styleClass="field-label" />
          <ComboBox fx:id="commentSortComboBox" prefWidth="120" styleClass="modern-combo-box" />
        </VBox>
      </HBox>

      <!-- Add Comment Form -->
      <VBox spacing="15"
        style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-background-radius: 8;">
        <Label text="Join the discussion" styleClass="section-title" />
        <TextArea fx:id="commentTextArea" promptText="Share your thoughts about this post..."
          prefHeight="100" wrapText="true" styleClass="modern-text-area" />
        <HBox alignment="CENTER_LEFT" spacing="10">
          <CheckBox fx:id="notifyRepliesCheck" text="Notify me of replies"
            styleClass="modern-checkbox" />
          <Region HBox.hgrow="ALWAYS" />
          <Button fx:id="cancelCommentBtn" text="Cancel" styleClass="secondary-button" />
          <Button fx:id="postCommentBtn" text="💬 Post Comment" styleClass="primary-button" />
        </HBox>
      </VBox>

      <!-- Comments List -->
      <VBox fx:id="commentsContainer" spacing="15" style="-fx-padding: 10 0;" />
    </VBox>

  </VBox>
</ScrollPane>
