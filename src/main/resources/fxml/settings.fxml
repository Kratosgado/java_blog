<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.SettingsController"
  fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
  stylesheets="@../css/theme.css">

  <VBox spacing="30" style="-fx-background-color: transparent;">

    <!-- Header -->
    <VBox spacing="5">
      <Label text="Settings"
        style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
      <Label text="Customize your blog experience"
        styleClass="subtitle-text" style="-fx-font-size: 14px;" />
    </VBox>

    <!-- Notifications -->
    <VBox spacing="24" styleClass="card" style="-fx-padding: 32; -fx-background-radius: 16;">
      <Label text="🔔 Notifications"
        style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

      <VBox spacing="20" style="-fx-padding: 10 0;">
        <HBox spacing="20" alignment="CENTER_LEFT">
          <CheckBox fx:id="emailNotificationsCheckbox" />
          <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Email Notifications"
              style="-fx-font-size: 15px; -fx-font-weight: 600; -fx-text-fill: #111827;" />
            <Label text="Receive email notifications about your account activity"
              styleClass="info-text" style="-fx-font-size: 13px;" />
          </VBox>
        </HBox>

        <HBox spacing="20" alignment="CENTER_LEFT">
          <CheckBox fx:id="commentNotificationsCheckbox" />
          <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Comment Notifications"
              style="-fx-font-size: 15px; -fx-font-weight: 600; -fx-text-fill: #111827;" />
            <Label text="Get notified when someone comments on your posts"
              styleClass="info-text" style="-fx-font-size: 13px;" />
          </VBox>
        </HBox>

        <HBox spacing="20" alignment="CENTER_LEFT">
          <CheckBox fx:id="publishNotificationsCheckbox" />
          <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Publish Notifications"
              style="-fx-font-size: 15px; -fx-font-weight: 600; -fx-text-fill: #111827;" />
            <Label text="Notify followers when you publish new content"
              styleClass="info-text" style="-fx-font-size: 13px;" />
          </VBox>
        </HBox>
      </VBox>
    </VBox>

    <!-- Appearance -->
    <VBox spacing="24" styleClass="card" style="-fx-padding: 32; -fx-background-radius: 16;">
      <Label text="🎨 Appearance"
        style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

      <GridPane hgap="24" vgap="20">
        <columnConstraints>
          <ColumnConstraints percentWidth="50" />
          <ColumnConstraints percentWidth="50" />
        </columnConstraints>

        <VBox spacing="10" GridPane.columnIndex="0">
          <Label text="Theme" styleClass="field-label" />
          <ComboBox fx:id="themeComboBox" promptText="Select theme"
            maxWidth="Infinity" styleClass="modern-combo-box" />
        </VBox>

        <VBox spacing="10" GridPane.columnIndex="1">
          <Label text="Language" styleClass="field-label" />
          <ComboBox fx:id="languageComboBox" promptText="Select language"
            maxWidth="Infinity" styleClass="modern-combo-box" />
        </VBox>
      </GridPane>
    </VBox>

    <!-- Message -->
    <Label fx:id="messageLabel" wrapText="true" styleClass="info-text" />

    <!-- Actions -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
      <Button fx:id="resetSettingsBtn" text="Reset to Default" styleClass="outline" />
      <Button fx:id="saveSettingsBtn" text="💾 Save Settings" styleClass="success-button" />
    </HBox>
  </VBox>
</ScrollPane>
