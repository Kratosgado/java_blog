<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.Scene?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.SignUpController"
  style="-fx-background-color: #f5f5f5;"
  stylesheets="@../css/enhanced-theme.css">
  <VBox alignment="CENTER" spacing="20" maxWidth="450" maxHeight="600"
    styleClass="card">
    <padding>
      <Insets top="40" right="40" bottom="40" left="40" />
    </padding>

    <Label text="Create Account" styleClass="title" />

<!-- Profile Picture Section -->
    <VBox spacing="15" alignment="CENTER" styleClass="avatar-container">
      <StackPane alignment="CENTER">
        <ImageView fx:id="avatarImageView" 
          fitWidth="100" fitHeight="100" 
          styleClass="avatar-image"></ImageView>
        <Button fx:id="uploadAvatarButton" text="📷" 
          styleClass="upload-button"
          StackPane.alignment="BOTTOM_RIGHT" />
      </StackPane>
      <Label fx:id="fileNameLabel" text="No file selected" styleClass="file-name-label" />
    </VBox>

    <!-- Form Fields -->
    <VBox spacing="15" style="-fx-alignment: center;">
      <VBox spacing="5">
        <Label text="Username" styleClass="field-label" />
        <TextField fx:id="usernameField" prefWidth="350" styleClass="modern-text-field" />
      </VBox>
      <VBox spacing="5">
        <Label text="Email" styleClass="field-label" />
        <TextField fx:id="emailField" prefWidth="350" styleClass="modern-text-field" />
      </VBox>
      <VBox spacing="5">
        <Label text="Password" styleClass="field-label" />
        <PasswordField fx:id="passwordField" prefWidth="350" styleClass="modern-text-field" />
      </VBox>
      <VBox spacing="5">
        <Label text="Confirm Password" styleClass="field-label" />
        <PasswordField fx:id="confirmPasswordField" prefWidth="350" styleClass="modern-text-field" />
      </VBox>
    </VBox>

    <Label fx:id="infoLabel" wrapText="true" maxWidth="350" styleClass="info-text" />

    <Button fx:id="signUpButton" text="Sign Up" prefWidth="350" styleClass="primary-button" />

    <HBox alignment="CENTER" spacing="5">
      <Label text="Already have an account?" styleClass="muted-text" />
      <Button fx:id="loginLink" text="Login" styleClass="link-button" />
    </HBox>
  </VBox>
</StackPane>
