<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.SignUpController"
  style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, -primary-color 0%, #134ba2 100%);"
  stylesheets="@../css/theme.css">

  <VBox alignment="CENTER" maxWidth="500" styleClass="card"
    style="-fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 30, 0, 0, 10);">
    <padding>
      <Insets top="40" right="50" bottom="40" left="50" />
    </padding>

    <!-- Header -->
    <VBox alignment="CENTER" spacing="10">
      <Label text="✍️" style="-fx-font-size: 32px;" />
      <Label text="Create Account" styleClass="title" style="-fx-font-size: 28px;" />
      <Label text="Join our community of writers" styleClass="subtitle-text"
        style="-fx-font-size: 14px;" />
    </VBox>

    <Region prefHeight="30" />

    <!-- Avatar Section -->
    <VBox spacing="12" alignment="CENTER" styleClass="avatar-container">
      <StackPane alignment="CENTER">
        <ImageView fx:id="avatarImageView" fitWidth="100" fitHeight="100"
          styleClass="avatar-image" preserveRatio="true" />
        <Button fx:id="uploadAvatarButton" text="📷" styleClass="upload-button"
          StackPane.alignment="BOTTOM_RIGHT" />
      </StackPane>
      <Label fx:id="fileNameLabel" text="Upload your avatar" styleClass="file-name-label" />
    </VBox>

    <Region prefHeight="20" />

    <!-- Form Fields -->
    <VBox spacing="15">
      <VBox spacing="8">
        <Label text="Username" styleClass="field-label" />
        <TextField fx:id="usernameField" prefWidth="400"
          promptText="Choose a username" styleClass="modern-text-field" />
      </VBox>

      <VBox spacing="8">
        <Label text="Email Address" styleClass="field-label" />
        <TextField fx:id="emailField" prefWidth="400"
          promptText="Enter your email" styleClass="modern-text-field" />
      </VBox>

      <VBox spacing="8">
        <Label text="Password" styleClass="field-label" />
        <PasswordField fx:id="passwordField" prefWidth="400"
          promptText="Create a password" styleClass="modern-text-field" />
      </VBox>

      <VBox spacing="8">
        <Label text="Confirm Password" styleClass="field-label" />
        <PasswordField fx:id="confirmPasswordField" prefWidth="400"
          promptText="Confirm your password" styleClass="modern-text-field" />
      </VBox>
    </VBox>

    <!-- Error/Info Label -->
    <Label fx:id="infoLabel" wrapText="true" maxWidth="400" styleClass="info-text"
      style="-fx-min-height: 20;" />

    <Region prefHeight="10" />

    <!-- Sign Up Button -->
    <Button fx:id="signUpButton" text="Create Account" prefWidth="400"
      styleClass="primary-button-large" />

    <Region prefHeight="20" />

    <!-- Login Link -->
    <HBox alignment="CENTER" spacing="8">
      <Label text="Already have an account?" styleClass="muted-text" />
      <Button fx:id="loginLink" text="Sign In" styleClass="link-button"
        style="-fx-font-size: 14px; -fx-font-weight: 600;" />
    </HBox>
  </VBox>
</StackPane>
