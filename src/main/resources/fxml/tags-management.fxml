<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Scene?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.TagsManagementController" spacing="20"
  style="-fx-background-color: transparent;"
  stylesheets="@../css/enhanced-theme.css">

  <HBox alignment="CENTER_LEFT" spacing="15">
    <Label text="Tags Management" styleClass="page-title" />
    <Region HBox.hgrow="ALWAYS" />
    <Button fx:id="createTagBtn" text="+ Create Tag" onAction="#showCreateForm"
      styleClass="primary-button" />
  </HBox>

  <!-- Create/Edit Tag Form -->
  <VBox fx:id="tagFormContainer" spacing="15"
    style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
    managed="false" visible="false">
    <Label fx:id="formTitleLabel" text="Create New Tag" styleClass="form-title" />

    <HBox spacing="15" alignment="CENTER_LEFT">
      <VBox spacing="5" HBox.hgrow="ALWAYS">
        <Label text="Tag Name *" styleClass="field-label-required" />
        <TextField fx:id="tagNameField" promptText="Enter tag name" prefWidth="250"
          styleClass="modern-text-field" />
      </VBox>

      <VBox spacing="5">
        <Label text="Color" styleClass="field-label" />
        <ColorPicker fx:id="tagColorPicker" prefWidth="150" styleClass="modern-color-picker" />
      </VBox>
    </HBox>

    <VBox spacing="5">
      <Label text="Description" styleClass="field-label" />
      <TextArea fx:id="tagDescriptionArea" promptText="Optional description" prefHeight="80"
        wrapText="true" styleClass="modern-text-area" />
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
      <Button fx:id="cancelFormBtn" text="Cancel" styleClass="secondary-button" />
      <Button fx:id="saveTagBtn" text="Save Tag" styleClass="success-button" />
    </HBox>
  </VBox>

  <!-- Tags Grid -->
  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
    <VBox spacing="15">
      <Label text="All Tags" styleClass="section-title" />
      <FlowPane fx:id="tagsFlowPane" hgap="15" vgap="15" style="-fx-background-color: transparent;" />
    </VBox>
  </ScrollPane>
</VBox>
