<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.ImageView?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.kratosgado.blog.controllers.ProfileController"
  fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;"
  stylesheets="@../css/modern-ui.css">

  <VBox spacing="30" style="-fx-background-color: transparent;">

    <!--Header -->
    <VBox spacing="5">
      <Label text="My Profile"
        style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
      <Label text="Manage your personal information"
        styleClass="subtitle-text" style="-fx-font-size: 16px;" />
    </VBox>

    <!-- Profile Card -->
    <VBox spacing="30" styleClass="card" style="-fx-padding: 40; -fx-background-radius: 16;">

      <!-- Avatar Section -->
      <HBox spacing="30" alignment="CENTER_LEFT">
        <StackPane>
          <Circle fx:id="avatarCircle" radius="70" fill="#6366f1"
            stroke="#e5e7eb" strokeWidth="4" />
          <ImageView fx:id="avatarImageView" fitWidth="140" fitHeight="140"
            preserveRatio="true" />
        </StackPane>

        <VBox spacing="12" HBox.hgrow="ALWAYS">
          <Label fx:id="usernameLabel" text="Username"
            style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
          <Label fx:id="emailLabel" text="email@example.com"
            styleClass="subtitle-text" style="-fx-font-size: 16px;" />
          <Label fx:id="joinDateLabel" text="Member since January 2025"
            styleClass="info-text" style="-fx-font-size: 14px;" />
        </VBox>

        <Button fx:id="changeAvatarBtn" text="📷 Change Photo" styleClass="outline" />
      </HBox>

      <Separator />

      <!-- Edit Form -->
      <VBox spacing="24">
        <Label text="Profile Information"
          style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

        <GridPane hgap="24" vgap="20">
          <columnConstraints>
            <ColumnConstraints percentWidth="50" />
            <ColumnConstraints percentWidth="50" />
          </columnConstraints>

          <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <Label text="Display Name" styleClass="field-label" />
            <TextField fx:id="displayNameField" styleClass="modern-text-field" />
          </VBox>

          <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <Label text="Email" styleClass="field-label" />
            <TextField fx:id="emailField" styleClass="modern-text-field" />
          </VBox>

          <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
            <Label text="Bio" styleClass="field-label" />
            <TextArea fx:id="bioArea" promptText="Tell us about yourself..."
              prefHeight="100" wrapText="true"
              style="-fx-background-color: #ffffff; -fx-border-color: #e5e7eb; 
                     -fx-border-width: 2px; -fx-border-radius: 8px; 
                     -fx-background-radius: 8px; -fx-padding: 12; -fx-font-size: 14px;" />
          </VBox>

          <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Website" styleClass="field-label" />
            <TextField fx:id="websiteField" promptText="https://" styleClass="modern-text-field" />
          </VBox>

          <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Location" styleClass="field-label" />
            <TextField fx:id="locationField" styleClass="modern-text-field" />
          </VBox>
        </GridPane>
      </VBox>

      <Separator />

      <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="cancelBtn" text="Cancel" styleClass="outline" />
        <Button fx:id="saveProfileBtn" text="💾 Save Changes" styleClass="success-button" />
      </HBox>

      <Label fx:id="messageLabel" wrapText="true" styleClass="info-text" />
    </VBox>

    <!-- Change Password -->
    <VBox spacing="24" styleClass="card" style="-fx-padding: 32; -fx-background-radius: 16;">
      <Label text="🔒 Change Password"
        style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

      <VBox spacing="20">
        <VBox spacing="10">
          <Label text="Current Password" styleClass="field-label" />
          <PasswordField fx:id="currentPasswordField" maxWidth="400"
            styleClass="modern-text-field" />
        </VBox>

        <VBox spacing="10">
          <Label text="New Password" styleClass="field-label" />
          <PasswordField fx:id="newPasswordField" maxWidth="400"
            styleClass="modern-text-field" />
        </VBox>

        <VBox spacing="10">
          <Label text="Confirm New Password" styleClass="field-label" />
          <PasswordField fx:id="confirmNewPasswordField" maxWidth="400"
            styleClass="modern-text-field" />
        </VBox>
      </VBox>

      <HBox alignment="CENTER_LEFT">
        <Button fx:id="changePasswordBtn" text="Update Password"
          styleClass="primary-button" />
      </HBox>

      <Label fx:id="passwordMessageLabel" wrapText="true" styleClass="info-text" />
    </VBox>
  </VBox>
</ScrollPane>
